# Optional API keys. The pipeline runs 100% free with NONE of these set.
# Copy to `.env` and fill only the providers you actually want to use.

# --- Free stock stills/footage (free developer keys) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Optional paid upgrades (NOT required; leave blank for free path) ---
# Cloud video generation
RUNWAY_API_KEY=
# Premium TTS
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- Local generation toggles ---
# Force a specific LTX model tier instead of auto-selecting from hardware.
# One of: 13b-dev-fp8 | 13b-dev | 13b-distilled | 2b-distilled | 2b-distilled-fp8
LTX_TIER=
